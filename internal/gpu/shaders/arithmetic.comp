#version 460
#extension GL_GOOGLE_include_directive : require
#include "field.glsl"
#include "diagnostic.glsl"
layout(local_size_x = 64) in;
struct Command { Field first; Field second; Field unused; uint expected; uint generation; uint operation; };
layout(std430, binding = 2) readonly buffer Commands { Command commands[]; };
layout(std430, binding = 3) buffer Results { uint count; uint checked; uint pending; uint reserved; uint words[]; };
void main() {
	if (gl_LocalInvocationID.x != 0) { return; }
	uint index = gl_WorkGroupID.x;
	Command command = commands[index];
	Field result;
	switch (command.operation) {
		case 0: result = add(command.first, command.second); break;
		case 1: result = sub(command.first, command.second); break;
		case 2: result = mul(command.first, command.second); break;
		case 3: result = square(command.first); break;
		case 5: result = squares(command.first, 254); break;
		case 6:
			result = command.first;
			for (uint depth = 0; depth < 6; depth++) { result = mul(result, result); }
			break;
		case 7: result = mul(sub(command.first, command.second), add(command.first, command.second)); break;
		case 8: result = add(command.first, command.second); break;
		case 9: result = sub(command.first, command.second); break;
		case 10: result = fold(command.first, command.expected); break;
		case 11: result = canonical(command.first); break;
		case 12:
			uint64_t word = canonicalFirstWord(command.first);
			result = small(0);
			result.limb[0] = uint(word);
			result.limb[1] = uint(word >> 32);
			break;
		case 13:
			result = command.first;
			for (uint iteration = 0; iteration < 64; iteration++) {
				result = add(result, command.second);
				result = mul(result, result);
				result = sub(result, command.first);
				result = fold(result, command.expected);
			}
			result = canonical(result);
			break;
		case 14: result = canonical(denominatorPair(square(command.first), command.second, command.unused)); break;
		case 15:
			uint64_t provisional = provisionalProductWord(command.first, command.second);
			result = small(0);
			result.limb[0] = uint(provisional);
			result.limb[1] = uint(provisional >> 32);
			break;
		case 16: result = canonical(squareComplement(command.first)); break;
		case 17: result = canonical(inverse(command.first)); break;
		case 18: result = small(0); result.limb[0] = provisionalProductLow(command.first, command.second); break;
		default: result = inverse(command.first); break;
	}
	if (command.operation >= 8) {
		for (uint limb = 0; limb < 8; limb++) { words[index * 12 + limb] = result.limb[limb]; }
		for (uint limb = 8; limb < 12; limb++) { words[index * 12 + limb] = 0; }
		if (index == 0) { count = gl_NumWorkGroups.x * 2; }
		return;
	}
	result = canonical(result);
	bool noncanonical = true;
	for (int limb = 7; limb >= 0; limb--) {
		uint prime = limb == 7 ? 0x7fffffffu : (limb == 0 ? 0xffffffedu : 0xffffffffu);
		if (result.limb[limb] != prime) { noncanonical = result.limb[limb] > prime; break; }
	}
	Encoding encoded = storageLimbs(result);
	for (uint limb = 0; limb < 10; limb++) { words[index * 12 + limb] = encoded.limb[limb]; }
	words[index * 12 + 10] = uint(noncanonical);
	words[index * 12 + 11] = 0;
	if (index == 0) { count = gl_NumWorkGroups.x * 2; }
}
