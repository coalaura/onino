#version 460
#extension GL_GOOGLE_include_directive : require
#include "field.glsl"
#ifdef ONINO_DIAGNOSTIC
#include "diagnostic.glsl"
#endif

#ifndef ONINO_INITIAL_STEPS
#define ONINO_INITIAL_STEPS 128
#endif

const uint pairCount = 128;
const uint prepareFirst = 0;
const uint reconstructLast = 4;

layout(constant_id = 0) const uint kernelPhase = 0;
layout(local_size_x = 128, local_size_x_id = 1) in;
struct Affine { Field x; Field y; Field xy; };
// All storage layouts deliberately use uint words, avoiding host ABI padding.
struct Stream { Affine center; uint generation; uint steps; uint cursor; uint status; uint hitSteps; uint kind; uint low; uint high; uint completed; uint scratch[8][pairCount]; Affine next; };
struct Command { Affine center; uint expected; uint generation; uint action; };
struct Probe { uint lowMask; uint highMask; uint lowValue; uint highValue; };
struct Hit { uint stream; uint generation; uint steps; uint kind; uint low; uint high; };
layout(std430, binding = 0) buffer Streams { Stream streams[]; };
layout(std430, binding = 1) readonly buffer Tables { Affine offsets[pairCount + 1]; Probe probes[8]; uint probeCount; };
layout(std430, binding = 2) buffer Commands { Command commands[]; };
layout(std430, binding = 3) buffer Results { uint count; uint checked; uint pending; uint reserved; Hit hits[]; };
layout(push_constant) uniform Parameters { uint work; uint capacity; uint collectOnly; uint phase; } parameters;

// Neighboring lanes access neighboring nodes for each limb.
Field readNode(uint streamIndex, uint node) {
	Field value;
	for (uint limb = 0; limb < 8; limb++) { value.limb[limb] = streams[streamIndex].scratch[limb][node]; }
	return value;
}
void writeNode(uint streamIndex, uint node, Field value) {
	for (uint limb = 0; limb < 8; limb++) { streams[streamIndex].scratch[limb][node] = value.limb[limb]; }
}

shared Field products[kernelPhase == 1 ? 1 : 2 * pairCount];
shared uint winner;
shared uint running;
#ifdef ONINO_DIAGNOSTIC
shared uint matchedSign;
#endif

bool matches(uint64_t word) {
	for (uint index = 0; index < probeCount; index++) {
		Probe probe = probes[index];
		if ((uint(word) & probe.lowMask) == probe.lowValue && (uint(word >> 32) & probe.highMask) == probe.highValue) { return true; }
	}
	return false;
}
void publish(uint streamIndex) {
	if (streams[streamIndex].status != 1) { return; }
	uint destination = atomicAdd(count, 1);
	if (destination < parameters.capacity) {
		Stream stream = streams[streamIndex];
		hits[destination] = Hit(streamIndex, stream.generation, stream.hitSteps, stream.kind, stream.low, stream.high);
		streams[streamIndex].status = 2;
	} else { atomicAdd(pending, 1); }
}
void main() {
	// Adjacent invocations invert independent stream roots, with a separate 64-lane pipeline.
	if (kernelPhase == 1) {
		uint index = gl_GlobalInvocationID.x;
		if (index >= parameters.work || streams[index].status != 0 || parameters.collectOnly != 0) { return; }
		Field root = readNode(index, 1);
		Field jump = readNode(index, 0);
		Field combined = inverse(mul(root, jump));
		writeNode(index, 1, mul(jump, combined));
		Field reciprocalJump = mul(root, combined);
		Affine center = streams[index].center;
		Affine offset = offsets[pairCount];
		Field mixedJump = mul(center.xy, offset.xy);
		Field factorJump = mul(mixedJump, reciprocalJump);
		Field numeratorX = add(mul(center.x, offset.y), mul(center.y, offset.x));
		Field numeratorY = add(mul(center.y, offset.y), mul(center.x, offset.x));
		Affine next;
		next.x = mul(numeratorX, sub(reciprocalJump, factorJump));
		next.y = mul(numeratorY, add(reciprocalJump, factorJump));
		next.xy = mul(next.x, next.y);
		// Reconstruction still uses the old center; only a no-hit round commits this.
		streams[index].next = next;
		return;
	}
	uint streamIndex = gl_WorkGroupID.x;
	uint lane = gl_LocalInvocationID.x;
	uint localChecked = 0;
	if (lane == 0) {
		if (parameters.phase == prepareFirst) { streams[streamIndex].completed = 0; }
		Command command = commands[streamIndex];
		if (kernelPhase == 2) { command.action = 0; }
		if (command.action != 0 && command.expected == streams[streamIndex].generation) {
			if (command.action == 2) {
				streams[streamIndex].center = command.center;
				streams[streamIndex].generation = command.generation;
				streams[streamIndex].steps = ONINO_INITIAL_STEPS;
				streams[streamIndex].cursor = 0;
			}
			streams[streamIndex].status = 0;
		}
		commands[streamIndex].action = 0;
		running = uint(streams[streamIndex].status == 0 && parameters.collectOnly == 0);
	}
	memoryBarrierBuffer();
	barrier();
	for (uint round = 0; round < parameters.work && running != 0; round++) {
		Stream stream = streams[streamIndex];
		Affine offset = offsets[lane];
		Field productX = mul(stream.center.x, offset.x);
		Field productY = mul(stream.center.y, offset.y);
		Field mixed = mul(stream.center.xy, offset.xy);
		if (kernelPhase == 0) {
			products[pairCount + lane] = sub(small(1), square(mixed));
			barrier();
			for (uint size = pairCount / 2; size > 0; size >>= 1) {
				if (lane < size) { products[size + lane] = mul(products[2 * (size + lane)], products[2 * (size + lane) + 1]); }
				barrier();
			}
			if (lane == 0) {
				Field mixedJump = mul(stream.center.xy, offsets[pairCount].xy);
				products[0] = sub(small(1), square(mixedJump));
			}
			barrier();
			writeNode(streamIndex, lane, products[lane]);
			return;
		}
		products[lane] = readNode(streamIndex, lane);
		products[pairCount + lane] = sub(small(1), square(mixed));
		if (lane == 0) { winner = 2 * pairCount; }
		barrier();
		for (uint size = 1; size < pairCount; size <<= 1) {
			Field child;
			uint node = 2 * size + lane;
			if (lane < 2 * size) { child = mul(products[node / 2], products[node ^ 1]); }
			// Both sibling values must be consumed before either is overwritten.
			barrier();
			if (lane < 2 * size) { products[node] = child; }
			barrier();
		}
		Field reciprocal = products[pairCount + lane];
		Field factor = mul(mixed, reciprocal);
		Field plus = mul(add(productY, productX), add(reciprocal, factor));
		Field minus = mul(sub(productY, productX), sub(reciprocal, factor));
		uint64_t plusWord = canonicalFirstWord(plus);
		uint64_t minusWord = canonicalFirstWord(minus);
		uint plusIndex = 2 * lane;
		uint minusIndex = plusIndex + 1;
		if (plusIndex >= stream.cursor && matches(plusWord)) { atomicMin(winner, plusIndex); }
		if (minusIndex >= stream.cursor && matches(minusWord)) { atomicMin(winner, minusIndex); }
		barrier();
		if (winner / 2 == lane) {
#ifdef ONINO_DIAGNOSTIC
			Field crossFirst = mul(stream.center.x, offset.y);
			Field crossSecond = mul(stream.center.y, offset.x);
			Field abscissa = (winner & 1) == 0 ? mul(add(crossFirst, crossSecond), sub(reciprocal, factor)) : mul(sub(crossFirst, crossSecond), add(reciprocal, factor));
			matchedSign = canonical(abscissa).limb[0] & 1;
			// A match may precede the final pass; shared memory does not survive a dispatch.
			writeNode(streamIndex, 2, canonical((winner & 1) == 0 ? plus : minus));
			writeNode(streamIndex, 3, small(matchedSign));
#endif
			uint64_t word = (winner & 1) == 0 ? plusWord : minusWord;
			streams[streamIndex].low = uint(word);
			streams[streamIndex].high = uint(word >> 32);
			streams[streamIndex].hitSteps = (winner & 1) == 0 ? stream.steps + lane + 1 : stream.steps - lane - 1;
			streams[streamIndex].kind = 0;
		}
		barrier();
		if (lane == 0) {
			localChecked += min(winner + 1, 2 * pairCount) - stream.cursor;
			if (winner < 2 * pairCount) {
				streams[streamIndex].cursor = winner + 1;
				streams[streamIndex].status = 1;
				running = 0;
			} else if (stream.steps > 0xffffffffu - (3 * pairCount + 1)) {
				streams[streamIndex].kind = 1;
				streams[streamIndex].status = 1;
				running = 0;
			} else {
				streams[streamIndex].center = stream.next;
				streams[streamIndex].steps = stream.steps + 2 * pairCount + 1;
				streams[streamIndex].cursor = 0;
			}
		}
		memoryBarrierBuffer();
		barrier();
	}
	if (lane == 0) {
		streams[streamIndex].completed += localChecked;
		if (parameters.phase == reconstructLast) {
			if (streams[streamIndex].completed != 0) { atomicAdd(checked, streams[streamIndex].completed); }
			publish(streamIndex);
		}
	}
#ifdef ONINO_DIAGNOSTIC
	// Test-only full encoding of the selected candidate, using two ordinary record slots.
	if (lane == 0 && parameters.phase == reconstructLast) {
		Encoding encoded = storageLimbs(readNode(streamIndex, 2));
		matchedSign = readNode(streamIndex, 3).limb[0];
		hits[streamIndex * 2] = Hit(streams[streamIndex].hitSteps, streams[streamIndex].generation, encoded.limb[0], encoded.limb[1], encoded.limb[2], encoded.limb[3]);
		hits[streamIndex * 2 + 1] = Hit(encoded.limb[4], encoded.limb[5], encoded.limb[6], encoded.limb[7], encoded.limb[8], encoded.limb[9] | (matchedSign << 25));
		atomicAdd(count, 1);
	}
#endif
}
